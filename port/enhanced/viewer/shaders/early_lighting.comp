#version 430 core
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 9) writeonly buffer EarlyValues {
    uint values[];
};

layout(std430, binding = 10) writeonly buffer EarlyGuides {
    uint guides[];
};

uniform sampler2D early_depth;
uniform mat4 early_projection;
uniform mat4 early_view;
uniform samplerBuffer early_ao;
uniform int early_ao_enabled;
uniform int early_ao_scale;
uniform float early_ao_strength;
uniform samplerBuffer rtx_values;
uniform int rtx_enabled;
uniform int rtx_flags;
uniform int rtx_denoise;
uniform int rtx_debug_view;
// The result from an earlier frame (Metal traces a frame behind): read through that frame's camera.
uniform int rtx_reproject;
uniform mat4 rtx_source_view_projection;
uniform vec2 rtx_source_cells;
uniform samplerBuffer rtx_source_positions;  // that frame's cells (rtx_gbuffer.comp): 2 vec4 each

vec3 position_at(ivec2 pixel, float depth) {
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(textureSize(early_depth, 0)) * 2.0 - 1.0;
    float distance = early_projection[3][2] / (depth * 2.0 + (early_projection[2][2] - 1.0));
    return vec3(
               (ndc + early_projection[2].xy)
                   / vec2(early_projection[0][0], early_projection[1][1]),
               -1.0
           )
           * distance;
}

// Denoise the horizon estimate at the lighting receiver, rather than
// expanding AO into a separate full-resolution visibility texture.
float ambient_visibility(ivec2 pixel, vec3 centre, vec3 normal) {
    if (early_ao_enabled == 0) {
        return 1.0;
    }
    float visibility = 0.0, total = 0.0;
    ivec2 extent = (textureSize(early_depth, 0) + early_ao_scale - 1) / early_ao_scale;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 cell = clamp(pixel / early_ao_scale + ivec2(x, y), ivec2(0), extent - 1);
            vec4 guide = texelFetch(early_ao, cell.y * extent.x + cell.x);
            int selected = int(round(guide.g * 3.0));
            ivec2 tap = cell * early_ao_scale
                        + (early_ao_scale == 2 ? ivec2(selected & 1, selected >> 1) : ivec2(0));
            if (any(greaterThanEqual(tap, textureSize(early_depth, 0)))) {
                continue;
            }
            float depth = texelFetch(early_depth, tap, 0).r;
            if (depth <= 0.0) {
                continue;
            }
            vec3 delta = position_at(tap, depth) - centre;
            vec2 oct = guide.ba * 2.0 - 1.0;
            vec3 n = vec3(oct, 1.0 - abs(oct.x) - abs(oct.y));
            if (n.z < 0.0) {
                n.xy = (1.0 - abs(n.yx)) * mix(vec2(-1), vec2(1), greaterThanEqual(n.xy, vec2(0)));
            }
            float plane = abs(dot(normal, delta));
            float agreement = max(dot(normal, normalize(n)), 0.0);
            if (agreement < 0.85 || plane > 0.025) {
                continue;
            }
            if (abs(delta.z) > max(0.05, -centre.z * 0.01) && plane > 0.0025) {
                continue;
            }
            float weight =
                exp(-float(x * x + y * y) * 0.6 - plane * plane / 0.0025) * pow(agreement, 8.0);
            visibility += guide.r * weight;
            total += weight;
        }
    }
    float ao = total > 1e-5 ? visibility / total : 1.0;
    return clamp(1.0 - (1.0 - ao) * early_ao_strength, 0.0, 1.0);
}

// rtx_trace.comp's bounce, from its log encoding (encode_early_gi) back to light.
vec3 decode_rtx_gi(vec3 encoded) {
    return any(greaterThan(encoded, vec3(0.0))) ? exp2(encoded * 12.0 - (12.0 - log2(16.0)))
                                                : vec3(0.0);
}

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = textureSize(early_depth, 0), half_extent = (extent + 1) / 2;
    if (any(greaterThanEqual(cell, half_extent))) {
        return;
    }
    int index = cell.y * half_extent.x + cell.x;
    float depth = 0.0;
    uint selected = 0u;
    early_pixel = cell * 2;
    for (uint i = 0u; i < 4u; ++i) {
        ivec2 p = cell * 2 + ivec2(i & 1u, i >> 1u);
        if (any(greaterThanEqual(p, extent))) {
            continue;
        }
        float d = texelFetch(early_depth, p, 0).r;
        if (d > depth) {
            depth = d;
            early_pixel = p;
            selected = i;
        }
    }
    values[index] = 0u;
    guides[index * 2] = 0u;
    guides[index * 2 + 1] = 0u;
    if (depth <= 0.0) {
        return;
    }
    vec3 centre = position_at(early_pixel, depth);
    vec3 nv = smooth_normal_at(early_pixel, -centre);
    // Finish view-space AO before probe sampling to shorten receiver lifetimes.
    float ao = ambient_visibility(early_pixel, centre, nv);
    mat3 inverse_view = transpose(mat3(early_view));
    vec3 world = inverse_view * (centre - early_view[3].xyz);
    vec3 normal = inverse_view * nv;
    vec3 irradiance = vec3(0);
    bool covered = false;
    if (probe_mode == 1 || probe_mode == 2 || probe_mode == 4) {
        covered = sample_probe_irradiance(
            world, normal, probe_surface_bias(normal, inverse_view * (-centre)), irradiance
        );
    }
    float shadow = sun_shadow_visibility(world, normal, normal);
    // Where this point is in the traced grid: this frame's own cell, or, for a result traced a
    // frame or two earlier, the cell this world point had in that frame.
    ivec2 rtx_grid = half_extent;
    ivec2 rtx_cell = cell;
    bool rtx_here = rtx_enabled != 0;
    if (rtx_here && rtx_reproject != 0) {
        vec4 clip = rtx_source_view_projection * vec4(world, 1.0);
        vec2 uv = clip.w > 1e-4 ? clip.xy / clip.w * 0.5 + 0.5 : vec2(-1.0);
        rtx_grid = ivec2(rtx_source_cells);
        rtx_cell = clamp(ivec2(floor(uv * vec2(rtx_grid))), ivec2(0), rtx_grid - 1);
        rtx_here = all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)));
        // Only where that frame traced this same surface: after a fast turn, an edge or what was
        // hidden then shows another surface's light, which smeared across the picture.
        if (rtx_here) {
            vec4 traced = texelFetch(rtx_source_positions, (rtx_cell.y * rtx_grid.x + rtx_cell.x) * 2);
            float reach = max(0.3, -centre.z * 0.02);
            rtx_here = traced.w > 0.0 && distance(traced.xyz, world) < reach;
        }
    }
    int rtx_index = rtx_cell.y * rtx_grid.x + rtx_cell.x;
    float local_visibility = 1.0;  // of the local lights, traced (bits 28-31 of the guide)
    if (rtx_here) {
        // rtx_trace.comp's two words: (bounce, sun visibility), (weighted reflection, ambient
        // visibility). The filter averages decoded values, never the log-encoded bytes.
        vec4 s0 = texelFetch(rtx_values, rtx_index * 3);
        vec4 s1 = texelFetch(rtx_values, rtx_index * 3 + 1);
        float local = texelFetch(rtx_values, rtx_index * 3 + 2).r;
        vec3 gi = decode_rtx_gi(s0.rgb);
        float sun = s0.a, ambient = s1.a;
        vec3 reflection = s1.rgb;
        if (rtx_denoise != 0) {
            vec3 sum_gi = vec3(0.0), sum_refl = vec3(0.0);
            float sum_sun = 0.0, sum_ambient = 0.0, sum_local = 0.0, w_sum = 0.0;
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    ivec2 nc = clamp(cell + ivec2(dx, dy), ivec2(0), half_extent - 1);
                    ivec2 np = min(nc * 2, extent - 1);
                    float nd = texelFetch(early_depth, np, 0).r;
                    if (nd <= 0.0) {
                        continue;
                    }
                    float plane = abs(dot(nv, position_at(np, nd) - centre));
                    float w = exp(-float(dx * dx + dy * dy) * 0.5 - plane * plane / 0.01);
                    ivec2 rc = clamp(rtx_cell + ivec2(dx, dy), ivec2(0), rtx_grid - 1);
                    int nidx = rc.y * rtx_grid.x + rc.x;
                    vec4 n0 = texelFetch(rtx_values, nidx * 3);
                    vec4 n1 = texelFetch(rtx_values, nidx * 3 + 1);
                    sum_local += texelFetch(rtx_values, nidx * 3 + 2).r * w;
                    sum_gi += decode_rtx_gi(n0.rgb) * w;
                    sum_sun += n0.a * w;
                    sum_refl += n1.rgb * w;
                    sum_ambient += n1.a * w;
                    w_sum += w;
                }
            }
            if (w_sum > 1e-5) {
                gi = sum_gi / w_sum;
                sun = sum_sun / w_sum;
                reflection = sum_refl / w_sum;
                ambient = sum_ambient / w_sum;
                local = sum_local / w_sum;
            }
        }
        if (rtx_debug_view == 1) {
            irradiance = vec3(sun);
            shadow = sun;
            ao = 1.0;
            covered = true;
        } else if (rtx_debug_view == 2) {
            irradiance = vec3(ambient);
            shadow = 1.0;
            ao = 1.0;
            covered = true;
        } else if (rtx_debug_view == 3) {
            irradiance = reflection;
            shadow = 1.0;
            ao = 1.0;
            covered = true;
        } else if (rtx_debug_view == 4) {
            irradiance = gi;
            shadow = 1.0;
            ao = 1.0;
            covered = true;
        } else if (rtx_debug_view == 6) {
            irradiance = vec3(local);
            shadow = 1.0;
            ao = 1.0;
            covered = true;
        } else if (rtx_debug_view == 5) {
            irradiance = s0.rgb * 2.0;  // the trace's step heat map, not a light
            shadow = 1.0;
            ao = 1.0;
            covered = true;
        } else {
            // The bounce fills only where no probe reaches: a verified bake is the calibrated
            // light (all bounces, the sky), the traced one bounce of the sun is far dimmer, and
            // mixed in it darkened every lit level.
            if ((rtx_flags & 8) != 0 && !covered) {
                irradiance = gi;
                covered = true;
            }
            // Reflections are specular: Schlick's Fresnel keeps them to grazing angles instead of
            // washing every surface in the sky's colour as a diffuse light.
            if ((rtx_flags & 4) != 0 && covered) {
                float cos_v = clamp(dot(nv, normalize(-centre)), 0.0, 1.0);
                float fresnel = 0.04 + 0.96 * pow(1.0 - cos_v, 5.0);
                irradiance += reflection * fresnel;
            }
            // Traced AO replaces the screen-space one (not both: that darkened every corner
            // twice), at three quarters of its depth: a few rays a cell never prove a point
            // fully closed, and taken whole they left black blotches.
            if ((rtx_flags & 2) != 0) {
                ao = 1.0 - 0.75 * (1.0 - ambient);
            }
            // The traced sun visibility joins the shadow map's, the darker wins: the map tests
            // alpha (leaves, vines, fences), the trace adds what the map's reach and resolution
            // miss. Either way it touches only the sun's light, never the ambient.
            if ((rtx_flags & 1) != 0) {
                shadow = min(shadow, sun);
            }
            if ((rtx_flags & 16) != 0) {
                local_visibility = local;
            }
        }
    }
    irradiance *= ao;
    uint hero = uint(round(clamp(hero_shadow_sample(world, normal), 0.0, 1.0) * 255.0));
    // Log encoding spans the finite half-float lighting range. Decode each
    // candidate before spatial filtering; alpha is linear visibility.
    vec3 encoded = log2(1.0 + 16.0 * clamp(irradiance, vec3(0), vec3(65504))) / 20.0;
    values[index] = packUnorm4x8(vec4(encoded, shadow));
    vec2 oct = probe_oct(nv);
    uvec2 q = uvec2(round(oct * 255.0));
    guides[index * 2] = floatBitsToUint(depth);
    guides[index * 2 + 1] = q.x | (q.y << 8u) | (selected << 16u) | (covered ? 1u << 18u : 0u)
                            | (1u << 19u) | (hero << 20u)
                            | (uint(round((1.0 - clamp(local_visibility, 0.0, 1.0)) * 15.0)) << 28u);
}
